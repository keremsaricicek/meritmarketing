{
  "name": "merit-marketing-hub",
  "version": "1.0.0",
  "private": true,
  "description": "Merit Marketing Hub — casino marketing CRM. Single-file application plus its permanent QA, authorization and regression suite.",
  "scripts": {
    "test": "node tests/run-all.js",
