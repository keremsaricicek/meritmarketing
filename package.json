{
  "name": "merit-marketing-hub",
  "version": "1.0.0",
  "private": true,
  "description": "Merit Marketing Hub — casino marketing CRM desktop application.",
  "scripts": {
    "test": "ELECTRON_RUN_AS_NODE=1 node_modules/electron/dist/electron tests/run-all.js",
    "test:verbose": "ELECTRON_RUN_AS_NODE=1 node_modules/electron/dist/electron tests/run-all.js --verbose",
    "test:security": "ELECTRON_RUN_AS_NODE=1 node_modules/electron/dist/electron tests/run-all.js api-surface authorization regression",
    "test:business": "ELECTRON_RUN_AS_NODE=1 node_modules/electron/dist/electron tests/run-all.js business integrity",
    "test:ui": "ELECTRON_RUN_AS_NODE=1 node_modules/electron/dist/electron tests/run-all.js ui",
    "browser": "playwright install chromium",
    "surface:doc": "node tests/api-surface/generate-doc.js",
    "surface:check": "node tests/api-surface/generate-doc.js --check",
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "test:database": "ELECTRON_RUN_AS_NODE=1 node_modules/electron/dist/electron tests/run-all.js database",
    "test:electron": "ELECTRON_RUN_AS_NODE=1 node_modules/electron/dist/electron tests/run-all.js electron ipc",
    "test:migrations": "ELECTRON_RUN_AS_NODE=1 node_modules/electron/dist/electron tests/run-all.js migrations",
    "test:backup": "ELECTRON_RUN_AS_NODE=1 node_modules/electron/dist/electron tests/run-all.js backup",
    "extract:renderer": "node scripts/extract-renderer.js"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-squirrel": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "7.11.2",
    "@electron-forge/plugin-fuses": "7.11.2",
    "@electron/fuses": "1.8.0",
    "@electron/rebuild": "4.0.1",
    "electron": "43.4.1",
    "playwright": "^1.56.1"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@node-rs/argon2": "2.0.2",
    "electron-updater": "6.8.9",
    "zod": "4.1.11"
  },
  "main": "src/main/main.js",
  "productName": "Merit Marketing Hub"
}
