{
  "name": "merit-marketing-hub",
  "version": "1.0.0",
  "private": true,
  "description": "Merit Marketing Hub — casino marketing CRM desktop application.",
  "author": {
    "name": "Merit Marketing"
  },
  "scripts": {
    "test": "node scripts/run-tests.js",
    "test:verbose": "node scripts/run-tests.js --verbose",
    "test:security": "node scripts/run-tests.js api-surface authorization regression",
    "test:business": "node scripts/run-tests.js business integrity",
    "test:ui": "node scripts/run-tests.js ui",
    "browser": "playwright install chromium",
    "surface:doc": "node tests/api-surface/generate-doc.js && node scripts/generate-ipc-doc.js",
    "ipc:doc": "node scripts/generate-ipc-doc.js",
    "ipc:check": "node scripts/generate-ipc-doc.js --check",
    "surface:check": "node tests/api-surface/generate-doc.js --check && node scripts/generate-ipc-doc.js --check",
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "test:database": "node scripts/run-tests.js database",
    "test:electron": "node scripts/run-tests.js electron ipc",
    "test:migrations": "node scripts/run-tests.js migrations",
    "test:backup": "node scripts/run-tests.js backup",
    "extract:renderer": "node scripts/extract-renderer.js"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-squirrel": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "7.11.2",
    "@electron-forge/plugin-fuses": "7.11.2",
    "@electron/fuses": "1.8.0",
    "@electron/rebuild": "4.0.1",
    "electron": "43.4.1",
    "playwright": "^1.56.1"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@node-rs/argon2": "2.0.2",
    "electron-updater": "6.8.9",
    "zod": "4.1.11"
  },
  "main": "src/main/main.js",
  "productName": "Merit Marketing Hub"
}
