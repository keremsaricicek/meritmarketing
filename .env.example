# Merit Marketing Hub — build and release environment.
# Copy to .env for local use. NEVER commit a filled-in copy: .env is ignored.
# These are NAMES ONLY. No real value belongs in this file or in the repository.

# --- release identity -------------------------------------------------------
# stable | beta | internal. Chooses which update feed the build listens to.
MERIT_CHANNEL=

# --- update feed ------------------------------------------------------------
# HTTPS base URL the installed application READS update metadata from.
# Read-only for the client. Publishing credentials never live in the app.
# For a private repository, point this at static object storage (S3/R2) that
# is public-read for artifacts and authenticated for writes from CI only.
MERIT_UPDATE_URL=

# --- Windows code signing (CI secrets only) ---------------------------------
# Path to the .pfx on the build machine, and its password. Supplied by the CI
# secret store at build time; a certificate file must never be committed.
WINDOWS_CERT_FILE=
WINDOWS_CERT_PASSWORD=
WINDOWS_TIMESTAMP_SERVER=

# --- publishing (CI secrets only) -------------------------------------------
# Credentials for uploading artifacts to the update feed. CI only.
UPDATE_FEED_ACCESS_KEY_ID=
UPDATE_FEED_SECRET_ACCESS_KEY=
UPDATE_FEED_BUCKET=
UPDATE_FEED_ENDPOINT=
